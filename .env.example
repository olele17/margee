# ══════════════════════════════════════════════════════════════════
# Margee+ : variables d'environnement du FRONTEND
# Copie ce fichier en ".env.local" et remplis les valeurs.
# Dashboard Supabase → projet MARGEE → Project Settings → API
# ══════════════════════════════════════════════════════════════════

# URL du projet Supabase (publique)
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé "anon" / "publishable" (publique : elle est visible dans le navigateur,
# la sécurité repose sur les règles RLS de la base)
VITE_SUPABASE_ANON_KEY=votre-cle-anon

# ⚠️ NE JAMAIS mettre ici :
#   - la clé service_role (accès total à la base, contourne la RLS)
#   - la clé secrète Bictorys
# Ces secrets vont uniquement dans les secrets des Edge Functions :
#   npx supabase secrets set BICTORYS_SECRET_KEY=...
